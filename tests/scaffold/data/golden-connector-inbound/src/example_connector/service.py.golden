"""Service entry point — the reader, its durable cursor, and the run that drains them.

This module is the connector's only process. It stands on the kit's inbound read contract
(`pulse_core.connector`): a `RowSource` says where rows come from, `validate_page` turns one raw
page into validated rows plus counted `RowError`s, and a `CursorStore` makes the run resumable.
Nothing here knows which `RowSource` it holds — every test drives `FixtureRowSource`, production
passes a source-system adapter — and that is the seam that keeps this suite off the network.

What to replace, in order:

1. `CONTRACT_COLUMNS` and `SourceRow` — the columns this connector pins and the validated row it
   turns them into. `_validate_row` raises `RowValidationError` on the first violation; the kit
   catches it into a counted `RowError` naming the row's page offset and column, never a value.
2. `build_row_source` — the adapter for the real source. The scaffold returns an empty fixture
   source, so an unmodified package starts, reads nothing, and exits 0 rather than pretending.
3. `handle_page` — what this connector derives and declares per page. The scaffold counts the
   page and does nothing else; add the `submit_with_retry` call and record each settled response
   through the receipt so the counts stay true.

The crash/resume contract: `Reader.batches()` yields a page, the caller declares it, then
`commit()` persists the page position. A crash in between re-reads at most that one page, which
D16 idempotency classifies as replays downstream — correctness never depends on a fresh cursor.
"""

from __future__ import annotations

import argparse
import logging
import os
from dataclasses import dataclass
from typing import TYPE_CHECKING

from pulse_core.connector import (
    DEFAULT_PAGE_SIZE,
    CursorStore,
    FixtureRowSource,
    LedgerCursorStore,
    RowSource,
    ValidatedPage,
    parse_instant,
    required_string,
    required_timestamp,
    validate_page,
)
from pulse_core.cursor import validate_cursor

from example_connector.config import LEDGER_BASE_URL_ENV_VAR, Config, ConfigError
from example_connector.receipts import SERVICE_NAME, Receipt

if TYPE_CHECKING:
    from collections.abc import Iterator, Mapping, Sequence
    from datetime import datetime

logger = logging.getLogger(SERVICE_NAME)

#: The pinned row contract — the columns a source row must carry. Order is not significant to the
#: source; it is significant to `_validate_row`, which names the first column that fails, so a row
#: missing several is always reported by the same one.
CONTRACT_COLUMNS: tuple[str, ...] = ("subject_key", "event_id", "event_time")

#: The column the reader pages on. Must be orderable and timezone-aware ISO-8601.
CURSOR_COLUMN = "event_time"

#: The cursor's one page-position key.
_CURSOR_PAGE_KEY = CURSOR_COLUMN

#: This connector's own writer id — the durable cursor is scoped to it, distinct from any
#: command-attribution credential the declarer authenticates with.
CURSOR_WRITER_ID = "example-connector"


@dataclass(frozen=True)
class SourceRow:
    """One validated source row, timestamp parsed, ready to declare."""

    subject_key: str
    event_id: str
    event_time: datetime


def _validate_row(row: Mapping[str, object]) -> SourceRow:
    """Validate one raw row against `CONTRACT_COLUMNS`, raising on its first violation."""
    return SourceRow(
        subject_key=required_string(row, "subject_key"),
        event_id=required_string(row, "event_id"),
        event_time=required_timestamp(row, CURSOR_COLUMN),
    )


def _page_boundary(page: Sequence[Mapping[str, object]]) -> str | None:
    """The furthest position the reader can safely resume past: the max cursor value across every
    row in the page that parses one, valid or malformed alike. `None` when no row in the page has
    a parseable cursor value.

    Malformed rows count toward the boundary on purpose. A row that fails on some other column
    still occupies a real position in read order once its timestamp is known; excluding it would
    leave it eligible for the next `fetch(after=...)` and double-count it as a second `RowError`
    for the same physical row.
    """
    instants = [instant for row in page if (instant := parse_instant(row, CURSOR_COLUMN)) is not None]
    return max(instants).isoformat() if instants else None


class Reader:
    """Pages the source in read order and owns the durable cursor.

    `batches()` yields one `ValidatedPage` at a time. The caller declares the page's valid rows,
    records its errors on the run receipt, then calls `commit()` to persist the page position.
    """

    def __init__(self, source: RowSource, cursor_store: CursorStore, *, page_size: int = DEFAULT_PAGE_SIZE) -> None:
        if page_size < 1:
            msg = "page_size must be at least 1"
            raise ValueError(msg)
        self._source = source
        self._store = cursor_store
        self._page_size = page_size
        self._loaded = False
        #: The last *yielded* page's boundary; persisted only by `commit()`.
        self._position: str | None = None

    def _load_cursor(self) -> None:
        if self._loaded:
            return
        self._loaded = True
        cursor = self._store.load()
        if cursor is None:
            return
        position = cursor.get(_CURSOR_PAGE_KEY)
        self._position = position if isinstance(position, str) else None

    def batches(self) -> Iterator[ValidatedPage[SourceRow]]:
        """Yield validated pages in read order, resuming from the persisted cursor.

        A page whose rows all fail to parse a cursor value has no boundary to page past —
        re-fetching with the same `after` would return it forever — so the reader yields it once
        and stops. Its malformed rows are still counted and attached, never silently dropped; the
        run simply cannot advance until the drift is corrected upstream.
        """
        self._load_cursor()
        after = self._position
        while True:
            raw_page = self._source.fetch(after=after, limit=self._page_size)
            if not raw_page:
                return
            validated = validate_page(raw_page, _validate_row)
            boundary = _page_boundary(raw_page)
            if boundary is None:
                yield validated
                return
            after = boundary
            self._position = after
            yield validated

    def commit(self) -> None:
        """Persist the page position in one JSON-native save."""
        self._load_cursor()
        cursor: dict[str, object] = {_CURSOR_PAGE_KEY: self._position}
        self._store.save(validate_cursor(cursor))


def build_row_source(config: Config) -> RowSource:
    """The source this connector reads. Replace with the real adapter.

    The scaffold returns an empty fixture source so an unmodified package starts cleanly, reads
    nothing, and exits 0 — rather than opening a connection it has not been told how to make.
    """
    logger.warning("build_row_source is still the scaffold stub; %s is not being read", config.source_table)
    return FixtureRowSource([], cursor_column=CURSOR_COLUMN)


def handle_page(page: ValidatedPage[SourceRow], *, tally: Receipt) -> Receipt:
    """Act on one validated page and return the next tally. Never mutates `tally`.

    Scaffold behavior: count the page and do nothing with it. Replace this with the derivation
    and the `submit_with_retry` call this connector exists for — and count each settled response
    through the receipt so `committed`, `replayed` and `rejected` stay true.
    """
    logger.debug("page rows=%d errors=%d", len(page.rows), len(page.errors))
    return tally.record_page(page)


def run(
    config: Config,
    *,
    cursor_store: CursorStore,
    source: RowSource | None = None,
    max_pages: int | None = None,
) -> Receipt:
    """Drain the reader, accumulating one receipt across every page, and log it once.

    `source` is the seam every test uses: pass a `FixtureRowSource` and no adapter is built and no
    socket is opened. `max_pages` stops after that many pages, cursor committed, so a bounded run
    is an ordinary resume rather than a special case.
    """
    reader = Reader(
        source if source is not None else build_row_source(config),
        cursor_store,
        page_size=config.page_size,
    )
    tally = Receipt()
    for pages_read, page in enumerate(reader.batches(), start=1):
        tally = handle_page(page, tally=tally)
        reader.commit()
        if max_pages is not None and pages_read >= max_pages:
            break
    logger.info("%s", tally.format_line())
    return tally


def main(argv: Sequence[str] | None = None) -> int:
    """Resolve config and run. Returns a process exit code; never raises on bad config."""
    parser = argparse.ArgumentParser(prog=SERVICE_NAME, description=f"Run {SERVICE_NAME}")
    parser.add_argument(
        "--max-pages",
        type=int,
        default=None,
        help="stop after N pages, cursor committed (default: drain the source)",
    )
    args = parser.parse_args(argv)
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")

    try:
        config = Config.from_env()
    except ConfigError as exc:
        logger.error("%s", exc)  # noqa: TRY400 — the message is the whole diagnostic, not a trace
        return 2

    # The token's *value* is read here, at the one place it is used, from the variable
    # `config.credential_name` names — the config object never holds it.
    with LedgerCursorStore(
        config.ledger_base_url,
        writer_id=CURSOR_WRITER_ID,
        token=os.environ[config.credential_name],
        base_url_env_var=LEDGER_BASE_URL_ENV_VAR,
    ) as cursor_store:
        run(config, cursor_store=cursor_store, max_pages=args.max_pages)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
