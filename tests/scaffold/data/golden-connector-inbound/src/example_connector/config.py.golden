"""Connector configuration — one credential name, the source relation, paging, staleness.

The inbound counterpart of the outbound scaffold's `config.py`: same collect-every-problem shape,
different variables. An inbound connector pages a source system rather than consuming a queue, so
there is no queue URL here; what it needs instead is the relation to page and how large a page is.

`Config` holds the *name* of the environment variable this connector's token lives in, never the
token's value: whatever submits commands (and the durable cursor store) reads
`os.environ[config.credential_name]` at the one place it is used, so no secret is constructed,
stored, or defaulted here.

`from_env` collects **every** missing or invalid variable and raises a single `ConfigError` naming
each one, its expected type or unit, and where its value comes from. One start of the process
tells the operator everything that is wrong, not the first thing.
"""

from __future__ import annotations

import os
from dataclasses import dataclass
from datetime import timedelta
from typing import TYPE_CHECKING

from pulse_core.connector import DEFAULT_PAGE_SIZE

if TYPE_CHECKING:
    from collections.abc import Mapping

#: This connector's own writer credential *name* — the variable its token lives in. A constant,
#: not read from the environment: what varies by deploy is the value, never which variable
#: holds it.
TOKEN_ENV_VAR = "EXAMPLE_CONNECTOR_TOKEN"  # noqa: S105 — an env var name, not a secret

#: The relation this connector pages, fully qualified. The reader's `RowSource` adapter is what
#: interprets it; the scaffold only carries it through so no connector has to invent the variable.
SOURCE_TABLE_ENV_VAR = "EXAMPLE_CONNECTOR_SOURCE_TABLE"

#: The command-API base URL every declaration is submitted through, and where the durable cursor
#: lives (`GET/PUT /writers/{writer_id}/cursor`). An HTTP endpoint, never a database connection
#: string: reads come off the source, writes go through the command API.
LEDGER_BASE_URL_ENV_VAR = "EXAMPLE_CONNECTOR_LEDGER_BASE_URL"

#: Optional. How many rows one `RowSource.fetch` asks for. Rows tied on the cursor column are
#: never split across pages, so a real page can exceed this.
PAGE_SIZE_ENV_VAR = "EXAMPLE_CONNECTOR_PAGE_SIZE"

#: Optional. How old the newest row read may be before the connector reports the source as stale
#: instead of acting on it. Seconds.
STALE_AFTER_ENV_VAR = "EXAMPLE_CONNECTOR_STALE_AFTER_SECONDS"

DEFAULT_STALE_AFTER = timedelta(minutes=15)


class ConfigError(RuntimeError):
    """Startup configuration is unusable. Carries every problem found, not the first one."""

    def __init__(self, problems: list[str]) -> None:
        self.problems = list(problems)
        body = "\n".join(f"  - {problem}" for problem in self.problems)
        super().__init__(f"example-connector configuration is unusable:\n{body}")


def _resolve_stale_after(raw: str, problems: list[str]) -> timedelta:
    """Parse the optional staleness window, recording a problem rather than raising.

    Every `from_env` helper takes this shape — append and return a usable default, never raise —
    so one pass collects every problem instead of stopping at the first.
    """
    if not raw:
        return DEFAULT_STALE_AFTER
    try:
        seconds = int(raw)
    except ValueError:
        problems.append(f"{STALE_AFTER_ENV_VAR}={raw!r} is not an integer — whole seconds")
        return DEFAULT_STALE_AFTER
    if seconds <= 0:
        problems.append(f"{STALE_AFTER_ENV_VAR}={raw!r} must be positive — whole seconds")
        return DEFAULT_STALE_AFTER
    return timedelta(seconds=seconds)


def _resolve_page_size(raw: str, problems: list[str]) -> int:
    """Parse the optional page size, recording a problem rather than raising."""
    if not raw:
        return DEFAULT_PAGE_SIZE
    try:
        size = int(raw)
    except ValueError:
        problems.append(f"{PAGE_SIZE_ENV_VAR}={raw!r} is not an integer — whole rows")
        return DEFAULT_PAGE_SIZE
    if size <= 0:
        problems.append(f"{PAGE_SIZE_ENV_VAR}={raw!r} must be positive — whole rows")
        return DEFAULT_PAGE_SIZE
    return size


@dataclass(frozen=True)
class Config:
    """Everything this connector needs to start, resolved once at startup."""

    source_table: str
    ledger_base_url: str
    page_size: int = DEFAULT_PAGE_SIZE
    stale_after: timedelta = DEFAULT_STALE_AFTER
    credential_name: str = TOKEN_ENV_VAR

    @classmethod
    def from_env(cls, env: Mapping[str, str] | None = None) -> Config:
        """Resolve from `env` (defaults to `os.environ`), reporting every problem at once."""
        source = os.environ if env is None else env
        problems: list[str] = []

        source_table = source.get(SOURCE_TABLE_ENV_VAR, "").strip()
        if not source_table:
            problems.append(f"{SOURCE_TABLE_ENV_VAR} is unset — the fully qualified relation to page")

        ledger_base_url = source.get(LEDGER_BASE_URL_ENV_VAR, "").strip()
        if not ledger_base_url:
            problems.append(f"{LEDGER_BASE_URL_ENV_VAR} is unset — the command-API base URL")

        # Required to be *set*, never read: the value is the token, and this class never holds it.
        if not source.get(TOKEN_ENV_VAR, "").strip():
            problems.append(f"{TOKEN_ENV_VAR} is unset — this connector's ledger writer token")

        page_size = _resolve_page_size(source.get(PAGE_SIZE_ENV_VAR, "").strip(), problems)
        stale_after = _resolve_stale_after(source.get(STALE_AFTER_ENV_VAR, "").strip(), problems)

        if problems:
            raise ConfigError(problems)

        return cls(
            source_table=source_table,
            ledger_base_url=ledger_base_url,
            page_size=page_size,
            stale_after=stale_after,
        )
