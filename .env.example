# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# Never put PHI or real credentials in either file.

# Directory containing Orca worktrees. When unset, collect_handoffs.py falls
# back to `git worktree list`. See scripts/collect_handoffs.py.
ORCA_WORKTREES_DIR=

# `openlore generate` (living specs) needs an LLM provider key.
# `openlore init`, `analyze`, `drift` and the MCP server do not.
# ANTHROPIC_API_KEY=
