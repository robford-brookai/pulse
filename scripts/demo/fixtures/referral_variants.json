{
  "description": "Three referrals for demo5's one patient, in the shape `identity.matcher.resolve` consumes (packages/identity/tests/fixtures/*.json convention): the first mints a new person, the second matches that person exactly by identifier, and the third is ambiguous against two demographic-alike candidates and must quarantine for human review rather than guess. All keyed to brook-fx-demo5-episode-0001 (see MANIFEST.md). Synthetic demographics; no PHI.",
  "variants": [
    {
      "case": "mint",
      "description": "Nothing in the population matches this referral yet: unknown identifier, no composite candidates, so identity resolution mints brook-fx-demo5-episode-0001.",
      "referral": {
        "identifiers": [
          {"system": "PULSE-DEMO5", "value": "SYN-DEMO5-0001"}
        ],
        "demographics": {
          "first_name": "Jamie",
          "last_name": "Alvarez",
          "dob": "1990-03-14",
          "sex": "F"
        }
      },
      "existing_persons": [],
      "expected_decision": "mint",
      "expected_rule_id": "composite_none"
    },
    {
      "case": "exact_match",
      "description": "A second referral for the same patient carries the identifier the mint minted against, so it short-circuits straight to that person.",
      "referral": {
        "identifiers": [
          {"system": "PULSE-DEMO5", "value": "SYN-DEMO5-0001"}
        ],
        "demographics": {
          "first_name": "Jamie",
          "last_name": "Alvarez",
          "dob": "1990-03-14",
          "sex": "F"
        }
      },
      "existing_persons": [
        {
          "person_id": "brook-fx-demo5-episode-0001",
          "identifiers": [
            {"system": "PULSE-DEMO5", "value": "SYN-DEMO5-0001"}
          ],
          "demographics": {
            "first_name": "Jamie",
            "last_name": "Alvarez",
            "dob": "1990-03-14",
            "sex": "F"
          }
        }
      ],
      "expected_decision": "match",
      "expected_person_id": "brook-fx-demo5-episode-0001",
      "expected_rule_id": "identifier_exact"
    },
    {
      "case": "quarantine",
      "description": "A third referral for the same demographics carries no identifier and the population now holds two demographic-alike candidates — the patient's own resolved person and an unrelated decoy — so it quarantines rather than guessing.",
      "referral": {
        "identifiers": [],
        "demographics": {
          "first_name": "Jamie",
          "last_name": "Alvarez",
          "dob": "1990-03-14",
          "sex": "F"
        }
      },
      "existing_persons": [
        {
          "person_id": "brook-fx-demo5-episode-0001",
          "identifiers": [
            {"system": "PULSE-DEMO5", "value": "SYN-DEMO5-0001"}
          ],
          "demographics": {
            "first_name": "Jamie",
            "last_name": "Alvarez",
            "dob": "1990-03-14",
            "sex": "F"
          }
        },
        {
          "person_id": "brook-fx-demo5-episode-0001-decoy",
          "identifiers": [
            {"system": "MRN-OTHER", "value": "SYN-DEMO5-DECOY-0002"}
          ],
          "demographics": {
            "first_name": "Jamie",
            "last_name": "Alvarez",
            "dob": "1990-03-14",
            "sex": "F"
          }
        }
      ],
      "expected_decision": "ambiguous",
      "expected_candidate_person_ids": [
        "brook-fx-demo5-episode-0001",
        "brook-fx-demo5-episode-0001-decoy"
      ],
      "expected_rule_id": "composite_ambiguous"
    }
  ]
}
