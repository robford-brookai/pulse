[project]
name = "{{DIST}}"
version = "0.1.0"
description = "PULSE {{DIST}} — declares attributed, versioned facts on the ledger's single write path"
requires-python = ">=3.10,<4.0"
dependencies = [
    # The connector kit: the inbound read contract (`pulse_core.connector.rows`), the consume
    # loop (`consume`), and the declare pipeline (`submit_with_retry`, `DeclareCounts`). Importing
    # it anywhere under `src/` is also what brings this package under the credential-posture gate.
    "pulse-core",
]

[tool.uv.sources]
pulse-core = { workspace = true }

[dependency-groups]
dev = [
    # Enforces the no-live-network posture. `tests/conftest.py` blocks sockets for every run that
    # collects this package, including the combined `task test` run from the repo root.
    "pytest-socket>=0.7.0",
    # This package typechecks under pyright strict (see [tool.pyright] below). Add it to the
    # `typecheck` target's pyright list when you register the package.
    "pyright>=1.1.390",
    # `tests/factories.py`'s `FakeCommandTransport` fakes `PulseCoreClient` at the
    # `httpx.MockTransport` boundary — declared directly rather than relying on `pulse-core`'s
    # transitive pin, so the workspace resolves one httpx (billing-connector's precedent).
    "httpx>=0.28.1",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{NAME}}"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.pyright]
include = ["src", "tests"]
typeCheckingMode = "strict"

[tool.ruff]
extend = "../../pyproject.toml"

[tool.ruff.lint.isort]
# `src/{{NAME}}/*.py` gets this for free — a file inside the `{{NAME}}` package importing its own
# submodules is self-evidently first-party. A file under `tests/`, outside that package, is not,
# so without this isort falls back to bucketing `{{NAME}}` alongside `pulse_core` as one
# alphabetically sorted group — making the import order that renders clean depend on whether the
# connector's name sorts before or after "pulse_core". Declaring it explicitly here removes that
# dependency everywhere in the package, not just under src/.
known-first-party = ["{{NAME}}"]
